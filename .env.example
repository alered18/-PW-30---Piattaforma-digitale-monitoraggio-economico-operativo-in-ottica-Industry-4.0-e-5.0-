# Copiare in .env (che non va versionato) e modificare se serve.

# --- Porte esposte sul PC (cambiarle se già occupate da altri programmi) ---
PORTA_DB=5432
PORTA_BACKEND=8010
PORTA_FRONTEND=8080

# --- Database (PostgreSQL) ---
POSTGRES_DB=pw30
POSTGRES_USER=pw30
POSTGRES_PASSWORD=cambiami

# --- Back-end ---
# Indirizzo del database visto dal back-end dentro Docker Compose (host = nome del servizio "db").
DATABASE_URL=postgresql+psycopg://pw30:cambiami@db:5432/pw30
# Database dei test d'integrazione, raggiunto dal PC tramite la porta esposta.
DATABASE_URL_TEST=postgresql+psycopg://pw30:cambiami@localhost:5432/pw30_test

# --- Generatore ---
GEN_API_URL=http://backend:8000/api
GEN_MODALITA=auto
GEN_GIORNI=90
GEN_INTERVALLO_LIVE_S=5
GEN_SEME=42
